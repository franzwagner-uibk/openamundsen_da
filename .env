# Paths to mount into the container
# Linux paths for this machine
REPO=/home/franz/openamundsen_da
PROJ=${REPO}/examples/testsite

# Container user mapping (match your host UID/GID to avoid permission issues)
UID=1000
GID=1000

# Resource limits (keep within your WSL2/Docker Desktop global limits)
CPUS=48
MEMORY=128g
OMP_THREADS=1

# Notes:
# - Copy this file to ".env" and adjust values for your machine.
# - On Linux/macOS, use absolute POSIX paths for REPO/PROJ (e.g., /home/me/openamundsen_da).
# - On Windows PowerShell, you can also override a value ad-hoc, e.g.:
#     $env:MAX_WORKERS=2; docker compose run --rm oa

