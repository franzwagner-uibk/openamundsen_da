* text=auto eol=lf

# Keep common Windows scripts with CRLF if they are added later.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.tif binary
*.tiff binary
*.nc binary
